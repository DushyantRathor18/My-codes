Z","shell.execute_reply.started":"2025-04-02T10:57:42.170731Z","shell.execute_reply":"2025-04-02T10:57:42.428138Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 432x288 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":24},{"cell_type":"code","source":"# evaluating the model\n\nreturn_rmse(test, predicted)","metadata":{"trusted":true,"_uuid":"b8a50da710e6f70c7cea5d3aff173d612bcec084","execution":{"iopub.status.busy":"2025-04-02T10:57:42.431219Z","iopub.execute_input":"2025-04-02T10:57:42.431635Z","iopub.status.idle":"2025-04-02T10:57:42.441475Z","shell.execute_reply.started":"2025-04-02T10:57:42.431563Z","shell.execute_reply":"2025-04-02T10:57:42.440132Z"}},"outputs":[{"name":"stdout","text":"the root mean squared error is : 5.688163203345954.\n","output_type":"stream"}],"execution_count":25},{"cell_type":"markdown","source":"Gated Recurrent Units\n\nIn simple words, the GRU unit does not have to use a memory unit to control the flow of information like the LSTM unit. It can directly makes use of the all hidden states without any control. GRUs have fewer parameters and thus may train a bit faster or need less data to generalize. But, with large data, the LSTMs with higher expressiveness may lead to better results.\n\nThey are almost similar to LSTMs except that they have two gates: reset gate and update gate. Reset gate determines how to combine new input to previous memory and update gate determines how much of the previous state to keep. Update gate in GRU is what input gate and forget gate were in LSTM. We don't have the second non linearity in GRU before calculating the output, .neither they have the output gate.","metadata":{"_uuid":"89bcb2f3641ab26954a9f3abe2328c796a5aa7c0"}},{"cell_type":"code","source":"# The GRU architecture\nregressorGRU = Sequential()\n# First GRU layer with Dropout regularisation\nregressorGRU.add(GRU(units=50, return_sequences=True, input_shape=(x_train.shape[1],1), activation='tanh'))\nregressorGRU.add(Dropout(0.2))\n# Second GRU layer\nregressorGRU.add(GRU(units=50, return_sequences=True, input_shape=(x_train.shape[1],1), activation='tanh'))\nregressorGRU.add(Dropout(0.2))\n# Third GRU layer\nregressorGRU.add(GRU(units=50, return_sequences=True, input_shape=(x_train.shape[1],1), activation='tanh'))\nregressorGRU.add(Dropout(0.2))\n# Fourth GRU layer\nregressorGRU.add(GRU(units=50, activation='tanh'))\nregressorGRU.add(Dropout(0.2))\n# The output layer\nregressorGRU.add(Dense(units=1))","metadata":{"trusted":true,"_uuid":"a5aa8587cc5b6bce6b75d8d9ffb7e8649f3bacde","execution":{"iopub.status.busy":"2025-04-02T10:57:42.444204Z","iopub.execute_input":"2025-04-02T10:57:42.444945Z","iopub.status.idle":"2025-04-02T10:57:43.405527Z","shell.execute_reply.started":"2025-04-02T10:57:42.444860Z","shell.execute_reply":"2025-04-02T10:57:43.404357Z"}},"outputs":[],"execution_count":26},{"cell_type":"code","source":"# compiling the model\n\nregressorGRU.compile(optimizer=SGD(lr=0.01, decay=1e-7, momentum=0.9, nesterov=False), loss='mean_squared_error')\n\n# fitting the model\n\nregressorGRU.fit(x_train, y_train, epochs=5, batch_size=150)","metadata":{"trusted":true,"_uuid":"8a8fc071fea6be62a872f82682526410dde9affa","execution":{"iopub.status.busy":"2025-04-02T10:57:43.407294Z","iopub.execute_input":"2025-04-02T10:57:43.407835Z","iopub.status.idle":"2025-04-02T10:58:16.031284Z","shell.execute_reply.started":"2025-04-02T10:57:43.407592Z","shell.execute_reply":"2025-04-02T10:58:16.030532Z"}},"outputs":[{"name":"stdout","text":"Epoch 1/5\n2709/2709 [==============================] - 8s 3ms/step - loss: 0.1059\nEpoch 2/5\n2709/2709 [==============================] - 5s 2ms/step - loss: 0.0333\nEpoch 3/5\n2709/2709 [==============================] - 6s 2ms/step - loss: 0.0090\nEpoch 4/5\n2709/2709 [==============================] - 5s 2ms/step - loss: 0.0048\nEpoch 5/5\n2709/2709 [==============================] - 5s 2ms/step - loss: 0.0038\n","output_type":"stream"},{"execution_count":27,"output_type":"execute_result","data":{"text/plain":"<keras.callbacks.History at 0x7b4c5339aac8>"},"metadata":{}}],"execution_count":27},{"cell_type":"code","source":"# predicting the stock prices for test set and visualization\n\npredicted_with_gru = regressorGRU.predict(x_test)\npredicted_with_gru = sc.inverse_transform(predicted_with_gru)\n\nplot_predictions(test, predicted_with_gru)","metadata":{"trusted":true,"_uuid":"376daab22d311bb7734af6a12549389b920dafc0","execution":{"iopub.status.busy":"2025-04-02T10:58:16.032678Z","iopub.execute_input":"2025-04-02T10:58:16.032910Z","iopub.status.idle":"2025-04-02T10:58:17.078225Z","shell.execute_reply.started":"2025-04-02T10:58:16.032866Z","shell.execute_reply":"2025-04-02T10:58:17.076916Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 432x288 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":28},{"cell_type":"code","source":"# evaluating the model performance\n\nreturn_rmse(test, predicted_with_gru)","metadata":{"trusted":true,"_uuid":"f89d027315299d71067bad7537d577fe5451a337","execution":{"iopub.status.busy":"2025-04-02T10:58:17.079949Z","iopub.execute_input":"2025-04-02T10:58:17.080413Z","iopub.status.idle":"2025-04-02T10:58:17.089745Z","shell.execute_reply.started":"2025-04-02T10:58:17.080340Z","shell.execute_reply":"2025-04-02T10:58:17.088184Z"}},"outputs":[{"name":"stdout","text":"the root mean squared error is : 3.173561971041783.\n","output_type":"stream"}],"execution_count":29},{"cell_type":"markdown","source":"Thanks if you find it useful! :)","metadata":{"_uuid":"9cb818bc89b8a4d248ed4f1d151ce700c2ef5f7a"}},{"cell_type":"code","source":"","metadata":{"trusted":true,"_uuid":"582cb4a4b06dd42697de8f96826c32f73fc868f6"},"outputs":[],"execution_count":null}]}
